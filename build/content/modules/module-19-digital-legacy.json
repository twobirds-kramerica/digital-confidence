  "quiz": [
    {
      "question": "What is a \"digital footprint\"?",
      "options": [
        "A computer virus shaped like a foot",
        "The trail of data and accounts you leave behind through your online activity",
        "Your typed signature on a document",
        "A special printer for digital photos"
      ],
      "correct": 1,
      "explanation": "Your digital footprint includes all your online accounts, email addresses, social media profiles, and browsing history. Being aware of it helps you manage your privacy."
    },
    {
      "question": "Why is it important to write down a list of your important online accounts?",
      "options": [
        "So that advertisers can target you better",
        "So that a trusted person can help manage your accounts if you become unable to do so yourself",
        "To share the list on social media",
        "Banks require it by law"
      ],
      "correct": 1,
      "explanation": "A trusted account list (stored securely, not in plain view) ensures a family member or executor can access and close important accounts if needed. This is part of digital estate planning."
    },
    {
      "question": "The best place to store backup copies of your important digital photos is:",
      "options": [
        "Only on your phone",
        "iCloud AND a second backup (external hard drive or USB stick) kept at a different location",
        "On Facebook only",
        "Printed copies only"
      ],
      "correct": 1,
      "explanation": "The 3-2-1 rule: 3 copies, 2 different formats, 1 offsite. iCloud is your first backup. An external hard drive kept at a family member's home is your insurance."
    },
    {
      "question": "Facebook's Legacy Contact feature allows:",
      "options": [
        "A friend to take over your account while you are on holiday",
        "A trusted person you designate to manage your Facebook profile after you pass away",
        "Automatic deletion of your account after 30 days",
        "Two people to share one Facebook account"
      ],
      "correct": 1,
      "explanation": "Facebook Legacy Contact lets you designate someone to manage your account — updating your profile photo, pinning a tribute post — after you pass. Set it in Settings → Memorialisation Settings."
    },
    {
      "question": "\"Cleaning up your digital life\" before or during later life is valuable because:",
      "options": [
        "It makes your phone run faster",
        "It reduces the administrative burden on family and ensures your wishes are known regarding your accounts and data",
        "It is required by Canadian law",
        "It improves your credit score"
      ],
      "correct": 1,
      "explanation": "Closing unused accounts, documenting important ones, and noting your wishes (delete vs. memorialise) reduces the work for loved ones and ensures your digital legacy reflects what you want."
    }
