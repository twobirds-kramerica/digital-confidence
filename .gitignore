# Environment files (NEVER commit)
.env
.env.local
.env.production

# Analytics — service account credentials (NEVER commit)
_analytics/service-account.json
_analytics/node_modules/
_analytics/package-lock.json

# Feedback backups (contain personal data)
backups/feedback/

# macOS / Windows
.DS_Store
Thumbs.db

# Generator output (built on deploy — not committed)
dist/

# Local editor files
.vscode/settings.json
*.swp

# Temporary agent-generated audit/migration scripts
_audit/*.js

# Playwright (S-029) — CI-only test harness, never commit local runs
tests/playwright/node_modules/
tests/playwright/test-results/
tests/playwright/playwright-report/
tests/playwright/blob-report/
tests/playwright/.last-run.json
